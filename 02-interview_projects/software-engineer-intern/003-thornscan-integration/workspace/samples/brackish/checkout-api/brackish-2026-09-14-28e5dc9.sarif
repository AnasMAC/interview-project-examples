          "rules": [
            {
              "id": "BRK-SQLI-001",
              "name": "sql-from-request",
              "shortDescription": {
                "text": "SQL query built from request data"
              },
              "helpUri": "https://brackish.example.test/rules/BRK-SQLI-001",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-89"
                ],
                "security-severity": "8.8",
                "precision": "high"
              }
            },
            {
              "id": "BRK-SSRF-005",
              "name": "ssrf-unvalidated-url",
