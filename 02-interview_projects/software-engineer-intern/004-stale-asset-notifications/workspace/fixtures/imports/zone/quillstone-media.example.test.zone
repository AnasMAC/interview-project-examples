; Quillstone Media -- generated by zonegen 2.3 from the platform CMDB
; DO NOT EDIT BY HAND
$TTL 1h
$ORIGIN quillstone-media.example.test.
@ 1h IN SOA ns-a.quillstone-media.example.test. dns-admin.quillstone-media.example.test. (
    2026110312 4h 30m 2w 5m )
@ NS ns-a
@ NS ns-b
@ IN 300 A 203.0.113.140
@ MX 0 .   ; no mail at the apex, see mail.quillstone-media.example.test
@ IN TXT ( "v=spf1 -all" )
google-site-verification IN TXT "qs-verify=7c1e9a0b"
_acme-challenge.www 60 IN TXT "Zq0mXk1pRrT; rotated by the cert bot"
ns-a IN A 203.0.113.131
ns-b IN A 198.51.100.131
www IN CNAME cdn-edge
cdn-edge 300 IN A 203.0.113.150
         300 IN A 203.0.113.151
         300 IN AAAA 2001:db8:9e1::150
img IN CNAME cdn-edge
video IN CNAME cdn-edge
cms IN A 203.0.113.160
cms-staging IN A 10.30.4.12   ; reachable over the VPN only
*.preview IN A 203.0.113.170  ; per-branch preview builds
café IN A 203.0.113.141       ; French edition landing page
mail IN MX 10 mx.mailrelay.example.test.
legal-archive.example.test. IN A 192.0.2.80   ; belongs to the legal team's zone, exported by mistake
$INCLUDE /etc/zones/quillstone-dkim.inc

$ORIGIN shop
@ IN A 203.0.113.180
checkout IN A 203.0.113.181
static IN CNAME cdn-edge.quillstone-media.example.test.
