# Bellpost local environment.
#
# Copy to .env and adjust; `make` loads .env automatically and Docker Compose
# reads it for the port substitution below. Every value here is a local demo
# value and is safe to commit.
#
#   cp .env.example .env
#
# Ports (all four are overridable):
#   BELLPOST_DB_PORT    Postgres on 127.0.0.1       (default 55432)
#   BELLPOST_WEB_PORT   Flask app on 127.0.0.1      (default 8080)
#   MOCKHOOK_PORT       webhook receiver on 127.0.0.1 (default 8900)
#   MOCK_METADATA_PORT  metadata stand-in on 127.0.0.1 (default 8901)

# --- application -------------------------------------------------------------
BELLPOST_ENV=development
BELLPOST_SECRET_KEY=DEMO-session-secret-not-for-production
BELLPOST_LOG_LEVEL=INFO
# Freeze the clock for local development; ignored when BELLPOST_ENV=production.
BELLPOST_NOW=2026-05-11T09:00:00+01:00

# --- database ----------------------------------------------------------------
BELLPOST_DB_PORT=55432
BELLPOST_DATABASE_URL=postgresql+psycopg://bellpost:bellpost@127.0.0.1:55432/bellpost

# --- storage and spool -------------------------------------------------------
BELLPOST_ATTACHMENT_ROOT=var/attachments
BELLPOST_SPOOL_DIR=spool/incoming
BELLPOST_SPOOL_PROCESSED_DIR=spool/processed
BELLPOST_SPOOL_FAILED_DIR=spool/failed

# --- web ports ---------------------------------------------------------------
BELLPOST_WEB_PORT=8080

# --- local mocks -------------------------------------------------------------
MOCKHOOK_PORT=8900
MOCKHOOK_STRICT=0
MOCKHOOK_LOG=var/mockhook/deliveries.jsonl
MOCKHOOK_SECRET=DEMO-whsec-local-mockhook
MOCK_METADATA_PORT=8901
