# Archived local settings for the old helpdesk deployment, kept for the
# operator notes. Superseded by .env.example in 1.3 when the product was
# renamed; nothing here is used by the current code. The HELPDESK_ names are
# still read as a fallback (see app/config.py).

HELPDESK_ENV=development
HELPDESK_SECRET_KEY=DEMO-legacy-2019-session-secret
HELPDESK_DATABASE_URL=postgresql://helpdesk:DEMO-legacy-password@127.0.0.1:5432/helpdesk
HELPDESK_ATTACHMENT_ROOT=var/attachments
HELPDESK_SPOOL_DIR=inbox
HELPDESK_LOG_LEVEL=INFO
HELPDESK_SMTP_HOST=mx.glasswick.example.test
HELPDESK_SMTP_USER=DEMO-helpdesk-smtp-user
HELPDESK_SMTP_PASSWORD=DEMO-helpdesk-smtp-password
