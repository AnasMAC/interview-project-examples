              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-798"
                ],
                "security-severity": "7.5",
                "precision": "high"
              },
              "messageStrings": {
                "default": {
                  "text": "Hard-coded credential assigned to {0}"
                },
                "test": {
                  "text": "Hard-coded credential {0} in test code"
                }
              }
            },
            {
              "id": "BRK-PATH-006",
              "name": "path-from-request",
              "shortDescription": {
                "text": "File path built from request data"
              },
              "helpUri": "https://brackish.example.test/rules/BRK-PATH-006",
