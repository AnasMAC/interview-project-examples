{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Brackish",
          "semanticVersion": "3.12.0",
          "informationUri": "https://brackish.example.test/docs",
          "rules": [
            {
              "id": "BRK-SQLI-001",
              "name": "sql-from-request",
              "shortDescription": {
                "text": "SQL query built from request data"
              },
              "helpUri": "https://brackish.example.test/rules/BRK-SQLI-001",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-89"
                ],
                "security-severity": "8.8",
                "precision": "high"
              }
            },
            {
              "id": "BRK-SSRF-005",
              "name": "ssrf-unvalidated-url",
              "shortDescription": {
                "text": "Outbound request to a URL taken from input"
              },
              "helpUri": "https://brackish.example.test/rules/BRK-SSRF-005",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-918"
                ],
                "security-severity": "8.1",
                "precision": "high"
              }
            },
            {
              "id": "BRK-XSS-002",
              "name": "template-unescaped-output",
              "shortDescription": {
                "text": "Template output marked safe without escaping"
              },
              "helpUri": "https://brackish.example.test/rules/BRK-XSS-002",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-79"
                ],
                "security-severity": "6.1",
                "precision": "high"
              }
            },
            {
